# Copy to import.env next to run-import.sh and fill in for the live server.
# import.env is read automatically and should never be committed.

# WordPress root -- the directory containing wp-load.php.
WP_PATH=/var/www/fantasiaimportada

# OpenCart images. OC_IMAGE_CATALOG is the "catalog" directory itself, i.e. the
# one holding products/ and categories/, usually <opencart>/image/catalog.
# It is symlinked into uploads read-only; nothing is ever written there.
OC_IMAGE_CATALOG=/var/www/bellacollezione/image/catalog
OC_IMAGE_CACHE=/var/www/bellacollezione/image/cache/catalog

# OpenCart database. Leave user/password/host blank to reuse the WordPress
# credentials from wp-config.php (correct when both databases share a server
# and the WordPress user can read the OpenCart schema).
OC_DB_NAME=bellacollezione
OC_DB_USER=
OC_DB_PASSWORD=
OC_DB_HOST=

# Publish policy for imported products:
#   draft   - import everything unpublished (default; safe first pass on a live store)
#   source  - mirror OpenCart's own status (enabled -> publish, disabled -> draft)
#   publish - publish everything
OC_IMPORT_STATUS=draft

# Products per batch. Progress is saved after each batch, so the run resumes
# from where it stopped if it is interrupted.
OC_BATCH=100
