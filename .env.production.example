# Copy to .env.production ON THE DROPLET and fill in. Never commit the real one:
# it carries the database password in plain text.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# These arrive as process environment in the container and are read by
# wordpress/wp-config.php through its fi_env() helper, which falls back to the
# LIVE values when a variable is absent. That fallback is why this file matters
# more than it looks: a missing variable does not fail loudly, it silently uses
# the old host's setting.

# THE ONE THAT MUST BE SET. wp-config.php falls back to `localhost`, which
# inside this container is the container itself -- so leaving this out does not
# reach the shared MariaDB, it fails to reach any database at all.
WORDPRESS_DB_HOST=mysql:3306

WORDPRESS_DB_NAME=fantasia_wpdb
WORDPRESS_DB_USER=fantasia

# Must match the grant created in the shared MariaDB. Grant on fantasia_wpdb
# ONLY -- never on bellacollezione or frizza_db. The importer's read access to
# the OpenCart catalog is a SEPARATE, SELECT-only user; see DEPLOYMENT.md.
WORDPRESS_DB_PASSWORD=

WORDPRESS_TABLE_PREFIX=wp_

# Cron comes from the system scheduler (tools/wp-cron.sh, every 5 minutes in
# root crontab) instead of from page views.
#
# WordPress otherwise fires cron opportunistically: each page view makes an
# extra HTTP request to itself, booting the whole WooCommerce stack again, at a
# rate set by TRAFFIC rather than by how much work is due. Measured here before
# the change: 70 self-requests per hour, 7.2 percent of all requests to the
# site, almost entirely driven by crawlers. On a shared single-vCPU droplet that
# is the largest avoidable cost this site has.
#
# THESE TWO SETTINGS ARE A PAIR. Unset this while the crontab entry exists and
# both mechanisms run. Remove the crontab entry while this stays set and
# scheduled work stops SILENTLY -- no posts publish, Action Scheduler stalls and
# the store sends no email, with nothing logged.
WORDPRESS_DISABLE_WP_CRON=1

# MUST NOT BE SET IN PRODUCTION, and is listed here only so nobody adds it by
# copying from docker-compose.yml. It switches wp-config.php to the localhost
# URLs, disables cron and drops the Really Simple SSL server-variable fix -- on
# the live site that means every URL WordPress emits points at localhost:8000.
#
#   WORDPRESS_LOCAL_DEV=1
